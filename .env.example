# =============================================================================
#  Proactive Guardian — environment file
# -----------------------------------------------------------------------------
#  Copy to .env in the same directory:   cp .env.example .env
#  scripts/guardian.sh auto-sources this file on every start/restart so you
#  never have to re-export in each new terminal.
#
#  DO NOT COMMIT .env — add it to .gitignore.
# =============================================================================

# ---- LLM provider -----------------------------------------------------------
# Leave OPENAI_API_KEY unset (or delete the line) to use the local Ollama
# profile (AiProfileSelector activates it automatically).
OPENAI_API_KEY=sk-REPLACE_ME

# ---- GitHub PR polling ------------------------------------------------------
# Personal access token (scopes: repo for private, public_repo for public).
# Without a token you get 60 anonymous API calls/hour and cannot see private repos.
GITHUB_TOKEN=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

# Enable the polling bean (GitHubPollingService). Must be literal 'true'.
GITHUB_POLL_ENABLED=false

# Poll interval in milliseconds. 6000 = every 6 seconds (good for dev).
GITHUB_POLL_INTERVAL_MS=6000

# Repo to watch. The pipeline expects a URL that ends in owner/repo(.git).
GITHUB_REPO_URL=https://github.com/softwarepravin2007/generateautocode.git
GITHUB_REPO_NAME=generateautocode

# Only needed if you switch to inbound webhooks + ngrok. Safe to leave blank.
# GITHUB_WEBHOOK_SECRET=

# ---- Ollama (local model) ---------------------------------------------------
# Only needed when GUARDIAN_AI_PROVIDER=local (or unset and no OpenAI/Databricks
# key). When GUARDIAN_AI_PROVIDER=databricks / openai / custom, AiProfileSelector
# now forces spring.ai.model.chat=openai and spring.ai.model.embedding=openai
# via a high-precedence PropertySource, so setting these to 'ollama' here has
# no effect (kept commented for the local fallback path).
# SPRING_AI_MODEL_CHAT=ollama
# SPRING_AI_MODEL_EMBEDDING=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Datastores (usually the app defaults are correct) ----------------------
# QDRANT_URL=http://localhost:6333
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASS=guardianpass

# ---- Confluence knowledge-base ingestion ------------------------------------
# Enables the ConfluenceIngester bean and the POST /ingest/confluence endpoint.
# Ingest with:  bash scripts/ingest-confluence.sh
GUARDIAN_CONFLUENCE_ENABLED=true

# Base URL of your Atlassian Cloud site (no trailing slash, no /wiki suffix).
CONFLUENCE_BASE_URL=https://softwarepravin2007.atlassian.net

# Atlassian account email used to authenticate the REST API.
CONFLUENCE_USER=softwarepravin2007@gmail.com


# API token — create at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_TOKEN=ATATT3xFfGF0rbTD1hlmsTfuu6LeXYT76FvNuCA2obWQbPrbWLJdfLvUMHLvfA95AhznwFQiLEFrwhgytaNlo4sFdjt-Q58JFWBF3ioX-trT-QUItLtukMvHD0XxcctrmjZvLNGnMdJ2lKKnJoRmFVRdOEqLpBMFnqIQ9DSHBwaV2NFhpiEuiR0=EACF37DB

# Optional: default personal space parsed from
#   https://softwarepravin2007.atlassian.net/wiki/spaces/~5e9d4815a77bf50c1ea301d5/overview
# Used by scripts/ingest-confluence.sh when no space key is passed.
CONFLUENCE_SPACE_KEY='~5e9d4815a77bf50c1ea301d5'

# ---- AI provider selection --------------------------------------------------
# AiProfileSelector picks the provider in this order (first match wins):
#   1. GUARDIAN_AI_PROVIDER = openai | databricks | custom | local  (explicit)
#   2. OPENAI_API_KEY set                                          → openai
#   3. DATABRICKS_HOST + DATABRICKS_TOKEN both set                 → databricks
#   4. SPRING_AI_OPENAI_BASE_URL set (no key)                      → custom
#   5. nothing configured                                          → local (Ollama)
#
# Uncomment ONE of the sections below.

# --- Option A: force local Ollama (default when nothing else is set) --------
# GUARDIAN_AI_PROVIDER=local
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Option B: Databricks Model Serving (AI/ML → Serving in the workspace) --
# Create a serving endpoint (or use a Foundation Model API endpoint) and a
# personal access token at:  <workspace>/settings/user/developer/access-tokens
# GUARDIAN_AI_PROVIDER=databricks
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# DATABRICKS_MODEL=databricks-meta-llama-3-1-70b-instruct
# DATABRICKS_EMBEDDING_MODEL=databricks-bge-large-en




GUARDIAN_AI_PROVIDER=databricks

# Serving endpoint UI URL:
#   https://ias-sandbox-dev.cloud.databricks.com/ml/endpoints/claude_code_sonnet_4_6/overview?o=1945641253100728
#   → DATABRICKS_HOST  = scheme + host
#   → DATABRICKS_MODEL = endpoint name segment after /ml/endpoints/
# Invocations URL that Spring AI will call becomes:
#   $DATABRICKS_HOST/serving-endpoints/$DATABRICKS_MODEL/invocations
DATABRICKS_HOST=<replace it with your workspace URL>
DATABRICKS_TOKEN=<replace it with your personal access token>
DATABRICKS_MODEL=databricks-claude-sonnet-4

# No embedding endpoint exists in this workspace that the token can query
# (FMAPI `databricks-gte-large-en` returned HTTP 403 "Invalid access to Org").
# Route embeddings to local Ollama; chat still goes to Databricks.
GUARDIAN_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# When an embedding endpoint is provisioned, set the line below and remove the
# three OLLAMA_* / GUARDIAN_EMBEDDING_PROVIDER lines above:
# DATABRICKS_EMBEDDING_MODEL=<endpoint-name>

# ---- SQS consumer ----------------------------
# Enable the SQS consumer (SqsGithubConsumer). Set to 'true' to replace
# GitHub polling with event-driven consumption from the upstream webhook relay.
SQS_ENABLED=true

# Full queue URL from the other AWS account.
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/QUEUE_NAME

# AWS credentials used by DefaultCredentialsProvider (SQS + STS calls).
# Can be omitted if running on EC2/ECS with an instance role, or if
# ~/.aws/credentials is already configured.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS region the queue lives in.
AWS_REGION=us-east-1

# IAM role ARN to assume for cross-account access (leave blank if the queue
# policy directly grants access to your account's credentials).
SQS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME
